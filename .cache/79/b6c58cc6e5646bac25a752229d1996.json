dden;\r\n  background-color: #000;\r\n  color: #ffe81f;\r\n}\r\n\r\n#app {\r\n  width: 100vw;\r\n  height: 100vh;\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  z-index: 0;\r\n}\r\n\r\n#title-banner {\r\n  position: absolute;\r\n  top: 15px;\r\n  width: 100%;\r\n  text-align: center;\r\n  z-index: 10;\r\n  pointer-events: none;\r\n  text-shadow: 0 0 10px #ffe81f;\r\n}\r\n\r\n#title-banner h1 {\r\n  font-size: 1.3rem;\r\n  letter-spacing: 4px;\r\n  color: #ffe81f;\r\n}\r\n\r\n#title-banner p {\r\n  font-size: 0.75rem;\r\n  color: #88c0d0;\r\n}\r\n\r\n.ui-toggle {\r\n  position: absolute;\r\n  bottom: 0;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  z-index: 20;\r\n  background: rgba(5, 15, 25, 0.9);\r\n  border: 1px solid #ffe81f;\r\n  border-bottom: none;\r\n  border-radius: 8px 8px 0 0;\r\n  color: #ffe81f;\r\n  padding: 4px 16px;\r\n  font-size: 0.75rem;\r\n  cursor: pointer;\r\n  box-shadow: 0 -2px 10px rgba(0, 255, 225, 0.3);\r\n  z-index: 250 !important;\r\n}\r\n\r\n.datapad-footer {\r\n  position: absolute;\r\n  bottom: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  background: rgba(5, 15, 25, 0.9);\r\n  border-top: 2px solid #ffe81f;\r\n  box-shadow: 0 0 20px rgba(0, 255, 225, 0.2);\r\n  padding: 10px 20px;\r\n  z-index: 10;\r\n  transition: transform 0.3s ease-in-out;\r\n  z-index: 100 !important;\r\n}\r\n\r\n.datapad-footer.collapsed {\r\n  transform: translateY(100%);\r\n}\r\n\r\n.datapad-content {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 25px;\r\n  flex-wrap: wrap;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.control-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.control-group label {\r\n  font-size: 0.7rem;\r\n  color: #ffe81f;\r\n  text-transform: uppercase;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.btn-row {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\nselect, button {\r\n  background: #0d233a;\r\n  border: 1px solid #ffe81f;\r\n  color: #ffe81f;\r\n  padding: 6px 12px;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 0.8rem;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\nselect:hover, button:hover {\r\n  background: #ffe81f;\r\n  color: #000;\r\n  box-shadow: 0 0 8px #ffe81f;\r\n}\r\n\r\n.nav-overlay {\r\n  position: absolute;\r\n  bottom: 85px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 15px;\r\n  z-index: 150 !important;\r\n  bottom: 110px !important;\r\n}\r\n\r\n.nav-overlay.hidden, .datapad-panel.hidden {\r\n  display: none !important;\r\n}\r\n\r\n.summary-bar {\r\n  background: rgba(5, 15, 25, 0.92);\r\n  border: 2px solid #ffe81f;\r\n  border-radius: 8px;\r\n  padding: 8px 18px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n  box-shadow: 0 0 15px rgba(255, 232, 31, 0.3);\r\n}\r\n\r\n#summary-planet-name {\r\n  font-weight: bold;\r\n  font-size: 1rem;\r\n  color: #00ffe1;\r\n  letter-spacing: 2px;\r\n}\r\n\r\n.summary-buttons {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.nav-btn {\r\n  background: rgba(5, 15, 25, 0.92);\r\n  border: 2px solid #ffe81f;\r\n  color: #ffe81f;\r\n  font-size: 1.2rem;\r\n  font-weight: bold;\r\n  padding: 8px 16px;\r\n  border-radius: 50%;\r\n}\r\n\r\n.btn-info {\r\n  background: #004455;\r\n  border-color: #00ffe1;\r\n  color: #00ffe1;\r\n}\r\n\r\n.btn-info:hover {\r\n  background: #00ffe1;\r\n  color: #000;\r\n}\r\n\r\n.btn-danger {\r\n  background: #660000;\r\n  border-color: #ff3333;\r\n  color: #ff3333;\r\n}\r\n\r\n.btn-danger:hover {\r\n  background: #ff3333;\r\n  color: #fff;\r\n  box-shadow: 0 0 10px #ff3333;\r\n}\r\n\r\n.datapad-panel {\r\n  position: absolute;\r\n  bottom: 150px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: 90%;\r\n  max-width: 600px;\r\n  background: rgba(5, 15, 25, 0.95);\r\n  border: 2px solid #00ffe1;\r\n  box-shadow: 0 0 20px rgba(0, 255, 225, 0.4);\r\n  border-radius: 10px;\r\n  padding: 20px;\r\n  z-index: 200 !important;\r\n  bottom: 120px !important;\r\n}\r\n\r\n.info-layout {\r\n  display: flex;\r\n  gap: 20px;\r\n  align-items: center;\r\n}\r\n\r\n.r2d2-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: rgba(0, 255, 225, 0.05);\r\n  border: 1px solid #00ffe1;\r\n  border-radius: 8px;\r\n  padding: 15px;\r\n  min-width: 110px;\r\n}\r\n\r\n.r2d2-avatar {\r\n  font-size: 3rem;\r\n  filter: drop-shadow(0 0 8px #00ffe1);\r\n  animation: pulseR2 2s infinite alternate;\r\n}\r\n\r\n.r2d2-label {\r\n  font-size: 0.65rem;\r\n  color: #00ffe1;\r\n  margin-top: 6px;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n@keyframes pulseR2 {\r\n  0% { opacity: 0.7; transform: scale(0.95); }\r\n  100% { opacity: 1; transform: scale(1.05); }\r\n}\r\n\r\n.info-content {\r\n  flex: 1;\r\n}\r\n\r\n.info-content h2 {\r\n  color: #ffe81f;\r\n  margin-bottom: 8px;\r\n  font-size: 1.2rem;\r\n  border-bottom: 1px solid #ffe81f;\r\n  padding-bottom: 4px;\r\n}\r\n\r\n.info-content p {\r\n  font-size: 0.8rem;\r\n  color: #e0f7fa;\r\n  line-height: 1.4;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.info-details {\r\n  display: flex;\r\n  gap: 15px;\r\n  font-size: 0.75rem;\r\n  color: #88c0d0;\r\n}\r\n\r\n.close-btn {\r\n  position: absolute;\r\n  top: 8px;\r\n  right: 12px;\r\n  background: transparent;\r\n  border: none;\r\n  color: #ff3333;\r\n  font-size: 1rem;\r\n  font-weight: bold;\r\n}\r\n\r\n#r2d2-canvas-container {\r\n  width: 110px;\r\n  height: 130px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}"},"lineCount":292}},"error":null,"hash":"d11bd2509334a6a46ad224948df4c5f5","cacheData":{"env":{}}}